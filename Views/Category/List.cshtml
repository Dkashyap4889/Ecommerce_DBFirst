@model IEnumerable<Ecommerce_DBFirst.Models.Category>


<h2>List Categories</h2>

<div class="mb-3">
    <a asp-action="Add" class="btn btn-success">Add New Category</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Category Id</th>
            <th>Category Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr id="category-row-@item.Id">
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-primary">
                        Edit
                    </a>
                    <button onclick="deleteCategory(@item.Id)"
                            class="btn btn-sm btn-danger">
                        Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        function deleteCategory(id) {
            if (confirm('Are you sure you want to delete this category?')) {
                fetch(`/Category/Delete/${id}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const row = document.getElementById(`category-row-${id}`);
                        row.remove();
                        alert(data.message);
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while deleting the category');
                });
            }
        }
    </script>
}
